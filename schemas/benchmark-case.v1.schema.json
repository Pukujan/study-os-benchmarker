{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukujan.github.io/study-os-benchmarker/schemas/benchmark-case.v1.schema.json",
  "title": "Study OS Benchmark Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context", "oracle"],
  "properties": {
    "schema_version": {"const": "benchmark.case.v1"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "case_id", "current_node", "visible_context", "visible_representation"],
      "properties": {
        "schema_version": {"const": "benchmark.candidate-context.v1"},
        "case_id": {"type": "string", "minLength": 1},
        "current_node": {"type": "string", "minLength": 1},
        "visible_context": {"type": "array", "items": {"type": "string"}},
        "visible_representation": {"type": "array", "items": {"type": "string"}}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "allowed_next_nodes", "required_bridge_ids", "required_representation", "forbidden_concepts", "answer_reveal_allowed", "forbidden_answer_literals"],
      "properties": {
        "schema_version": {"const": "benchmark.oracle.v1"},
        "allowed_next_nodes": {"type": "array", "items": {"type": "string"}},
        "required_bridge_ids": {"type": "array", "items": {"type": "string"}},
        "required_representation": {"type": "array", "items": {"type": "string"}},
        "forbidden_representation": {"type": "array", "items": {"type": "string"}},
        "forbidden_concepts": {"type": "array", "items": {"type": "string"}},
        "answer_reveal_allowed": {"type": "boolean"},
        "forbidden_answer_literals": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
